# 统一换行符：仓库里一律存 LF，避免 .sh 脚本在 Linux 上报 bad interpreter
* text=auto eol=lf

# 这些必须在 Linux 上以 LF 执行，显式锁死
*.sh   text eol=lf
*.bash text eol=lf
*.cnf  text eol=lf
*.conf text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.py   text eol=lf
*.php  text eol=lf

# 二进制 / 压缩包不要做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz  binary
*.zip binary
*.pdf binary
