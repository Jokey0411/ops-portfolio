[mysqld]
# =============================================================
#  LNMP 环境 MySQL 8.0 —— 2G 内存裁剪 + 慢查询开启
#  挂载为 /etc/mysql/conf.d/zz-lnmp.cnf
# =============================================================

server-id       = 10
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
default_time_zone = '+08:00'

# ---------------- 慢查询（简历：慢查询分析）----------------
slow_query_log              = 1
slow_query_log_file         = /var/log/mysql/slow.log
long_query_time             = 0.5            # 0.5 秒就算慢，测试环境压得狠一点
log_queries_not_using_indexes = 1            # 打开，才能抓到没走索引的查询
log_throttle_queries_not_using_indexes = 10  # 同类语句每分钟最多记 10 条，防刷屏
min_examined_row_limit      = 1000           # 扫描少于 1000 行的不记，减少噪音
log_slow_admin_statements   = 1

# ---------------- 内存裁剪（2G 机器）----------------
innodb_buffer_pool_size     = 256M           # 单实例，可以给大一点
innodb_buffer_pool_instances = 1
innodb_log_buffer_size      = 16M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method         = O_DIRECT
innodb_io_capacity          = 200
innodb_file_per_table       = 1

max_connections             = 80
thread_cache_size           = 8
table_open_cache            = 400
table_definition_cache      = 400
tmp_table_size              = 32M
max_heap_table_size         = 32M
sort_buffer_size            = 512K
join_buffer_size            = 512K
read_buffer_size            = 256K
read_rnd_buffer_size        = 512K
max_allowed_packet          = 64M

skip_name_resolve           = ON
performance_schema          = OFF            # 省 ~100MB；需要 sys schema 排错时临时打开

# ---------------- 其他 ----------------
lower_case_table_names      = 1
log_error                   = /var/log/mysql/error.log
