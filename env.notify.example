# 告警配置文件示例
# 复制为 /opt/ops/.env.notify 并填入真实值：
#   mkdir -p /opt/ops && cp env.notify.example /opt/ops/.env.notify && chmod 600 /opt/ops/.env.notify

# ---- 钉钉机器人（推荐，群设置 → 智能群助手 → 添加机器人 → 自定义）----
# 安全设置选"自定义关键词"时，关键词填：告警
DINGTALK_WEBHOOK="https://oapi.dingtalk.com/robot/send?access_token=你的token"
# 安全设置选"加签"时才需要下面这行
# DINGTALK_SECRET="SECxxxxxxxx"

# ---- 飞书机器人（备选）----
# FEISHU_WEBHOOK="https://open.feishu.cn/open-apis/bot/v2/hook/xxxx"

# ---- 邮件（需要额外安装配置 msmtp，可选）----
# MAIL_TO="347944013@qq.com"
