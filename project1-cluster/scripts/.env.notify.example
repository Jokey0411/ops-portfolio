# =============================================================
#  告警渠道配置模板
#  用法：复制到 /opt/ops/.env.notify 并填入真实值
#    cp .env.notify.example /opt/ops/.env.notify
#    chmod 600 /opt/ops/.env.notify        # 里面是机密，别让所有人读
# =============================================================

# ---------- 钉钉（二选一或都配）----------
# 机器人「安全设置」有三种模式，选哪种决定了下面填什么：
#
#   A. 自定义关键词  → 只填 WEBHOOK + KEYWORD
#      钉钉会检查消息内容里是否包含这个词，不含就直接拒（errcode 310000）
#
DINGTALK_WEBHOOK="https://oapi.dingtalk.com/robot/send?access_token=把这里换成你的"
DINGTALK_KEYWORD="告警"
#
#   B. 加签          → 填 WEBHOOK + SECRET（SEC 开头那串）
#      更安全，且不受内容限制。推荐用这个。
# DINGTALK_SECRET="SEC把这里换成你的"
#
#   C. IP 地址段     → 只填 WEBHOOK，同时在钉钉后台填服务器公网 IP
#
# ★ 注意：关键词和加签可以同时开，同时开时两个都要满足。
# ★ 关键词模式最常见的坑：内容里没有那个词。
#   本脚本会把 DINGTALK_KEYWORD 自动拼到标题里，所以填上就不会失败。

# ---------- 飞书（可选）----------
# FEISHU_WEBHOOK="https://open.feishu.cn/open-apis/bot/v2/hook/xxx"

# ---------- 邮件（可选，需要装 msmtp）----------
# MAIL_TO="you@qq.com"
